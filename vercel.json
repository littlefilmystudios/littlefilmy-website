{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work/work-a",
      "destination": "/work/commercials",
      "permanent": true
    },
    {
      "source": "/work/work-a.html",
      "destination": "/work/commercials",
      "permanent": true
    },
    {
      "source": "/work/work-b",
      "destination": "/work/animation",
      "permanent": true
    },
    {
      "source": "/work/work-b.html",
      "destination": "/work/animation",
      "permanent": true
    },
    {
      "source": "/work/work-c",
      "destination": "/work/commercials",
      "permanent": true
    },
    {
      "source": "/work/work-c.html",
      "destination": "/work/commercials",
      "permanent": true
    },
    {
      "source": "/contact/contact-a",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact/contact-a.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact/contact-b",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact/contact-b.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/jquery-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/webflow(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/littlefilmy.webflow.shared.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
